# Servidor
PORT=8000

# CORS - solo acepta requests de Node
ALLOWED_ORIGINS=http://localhost:3000

# Configuración OCR
TESSERACT_LANG=spa+eng
MIN_CONFIDENCE=60

# Entorno
ENVIRONMENT=development

# Gemini (extracción de datos de facturas). Deja vacío para usar solo regex.
# Genera una key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
